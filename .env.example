# Example environment file for hao-backprop-test.
# Copy to `.env` and adjust values as needed for your local environment.
# DO NOT commit `.env` — it is excluded via `.gitignore`.

# HTTP listen address (default 127.0.0.1 — loopback only, matches original Flask binding)
HOST=127.0.0.1

# HTTP listen port (default 3000 — matches original Flask binding)
PORT=3000

# Application environment (development | production)
NODE_ENV=development

# Winston log level (error | warn | info | http | verbose | debug | silly)
LOG_LEVEL=debug

# Directory where log files are written (relative to project root or absolute)
LOG_DIR=./logs
