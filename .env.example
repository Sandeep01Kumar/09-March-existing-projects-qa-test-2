# .env.example - Public template for environment variables.
# Copy to .env (which is gitignored) and adjust values as needed.
# Usage: cp .env.example .env
#
# This file is the canonical schema for the application's runtime configuration.
# It IS committed to version control so that developers, CI systems, and onboarding
# tooling can discover which variables the application consumes. The actual `.env`
# file (with potentially host-specific or sensitive values) is excluded from VCS
# via `.gitignore`.
#
# The default values below intentionally match the in-code defaults declared in
# `config/index.js`. As a result, copying this file to `.env` without further
# edits yields a working development configuration identical to running with no
# `.env` at all. Production environments override these values via PM2's
# `env_production` block in `ecosystem.config.js`.

# --- Network Binding ---
# HOST: Network interface to bind to (loopback by default for security).
#   Set to 0.0.0.0 to expose on all interfaces (NOT recommended without firewalling).
HOST=127.0.0.1

# PORT: TCP port to listen on.
PORT=3000

# --- Runtime Environment ---
# NODE_ENV: Runtime mode. Affects Express optimizations and logger transports.
#   Acceptable values: development | production | test
NODE_ENV=development

# --- Logging ---
# LOG_LEVEL: Winston severity threshold.
#   Acceptable values: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# LOG_DIR: Directory for log files (winston file transports in production, PM2 logs).
#   The directory will be created at startup if it does not exist.
LOG_DIR=./logs
