# Node.js dependencies
node_modules/

# Environment files (local secrets / per-host config)
.env
.env.local
.env.*.local

# Runtime logs — ignore contents of logs/ but keep the directory committed via .gitkeep
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PM2 runtime state
.pm2/

# OS / editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
