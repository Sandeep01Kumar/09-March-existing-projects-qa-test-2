# =============================================================================
# .gitignore - hao-backprop-test (Node.js / Express / PM2)
# -----------------------------------------------------------------------------
# Excludes Node.js dependencies, environment files (secrets), runtime log
# artifacts, PM2 daemon state, and OS / IDE / build artifacts from version
# control. Per AAP Section 0.6.1 (VCS Hygiene CREATE) and Section 0.7.2 R-007
# (.env must be gitignored). The .env.example template is intentionally NOT
# listed here because it must be committed for schema discoverability.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js dependencies and package manager artifacts
# -----------------------------------------------------------------------------
# node_modules/ is generated by `npm install` and is reproducible from
# package-lock.json; never commit it (typically hundreds of megabytes).
node_modules/

# Yarn Plug'n'Play files (defensive: project uses npm, not Yarn)
.pnp
.pnp.js

# npm cache (defensive: usually under $HOME, but ignore at repo level too)
.npm/

# -----------------------------------------------------------------------------
# Environment files (contain secrets - never commit)
# -----------------------------------------------------------------------------
# IMPORTANT: .env.example IS committed (it is the public schema template).
# Only the value-carrying .env files are excluded below.
.env
.env.local
.env.*.local

# -----------------------------------------------------------------------------
# Runtime logs
# -----------------------------------------------------------------------------
# The logs/ directory itself is tracked in VCS via logs/.gitkeep so that
# winston file transports have a writable destination on fresh clones (per
# AAP Section 0.5.3 and Section 0.7.2 R-008). The order matters: we ignore
# logs/* first, then negate the ignore for logs/.gitkeep so Git tracks it.
logs/*
!logs/.gitkeep

# Any *.log file at any path (covers winston combined.log, error.log,
# pm2-error.log, pm2-out.log, ad-hoc debug logs, etc.)
*.log

# Package manager debug / error log rotation patterns
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# PM2 process manager artifacts
# -----------------------------------------------------------------------------
# PM2 daemon state directory (typically under $HOME/.pm2 but defensive
# at repo level in case PM2 is started with a relative HOME).
.pm2/

# -----------------------------------------------------------------------------
# Operating system metadata
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Editor / IDE workspace settings
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Build / coverage / cache artifacts (defensive - not currently produced
# by this project, but listed so they cannot be accidentally committed
# if a build step or coverage tool is added later)
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
dist/
build/
.cache/

# -----------------------------------------------------------------------------
# Ad-hoc validation test files created by Blitzy implementation agents
# (these must never be committed; the prefix is the Blitzy convention)
# -----------------------------------------------------------------------------
blitzy_adhoc_test_*
